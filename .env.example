# Template for ~/.config/sizjobs/.env, which holds the real values OUTSIDE
# the repo. Names only here; never put a value in this file.
#
#   mkdir -p ~/.config/sizjobs
#   install -m 600 .env.example ~/.config/sizjobs/.env   # then fill it in
#   task secrets                                         # push to the cluster
#
# Format: KEY=value, one per line, no quotes needed, no multi-line values.
# Which Kubernetes Secret and namespace each key goes to is defined in
# config/secrets-map.yaml. Leave a key empty until its task needs it;
# `task secrets` skips Secrets with no values and names what is missing.

# --- s3 (a2-3): access and secret key of the S3 gateway's admin identity.
# Locally SeaweedFS (docs/adr/0006-local-s3-seaweedfs.md); choose any
# values, e.g. `openssl rand -hex 10` and `openssl rand -hex 20`. In Part B
# apps use IAM roles for AWS S3 and these go away.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- postgres (a2-4): passwords of the agent and litellm database roles
# in the jobs cluster. Choose any, e.g. `openssl rand -hex 24` (hex: no
# characters that need escaping in a connection URL). Changing one later
# and running `task secrets` rotates it in Postgres.
PG_AGENT_PASSWORD=
PG_LITELLM_PASSWORD=

# --- llm (a3-1): LiteLLM's keys, Secret llm/litellm.
# Master key: the gateway's admin key (admin API, admin UI). Must start
# with "sk-": `echo "sk-$(openssl rand -hex 32)"`. Only LiteLLM and the
# llm:* tasks use it; no app ever gets it.
# Salt key: encrypts provider credentials LiteLLM stores in its database.
# A different value from the master key: `openssl rand -hex 32`. Set it
# before the first start and never change it: stored credentials would
# no longer decrypt.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# The agent's virtual key, Secret agents/llm-key. Do not fill it in by
# hand: `task llm:key` creates it in LiteLLM and writes it here
# (ROTATE=1 replaces it), then `task secrets` pushes it to the cluster.
LITELLM_AGENT_KEY=

# --- bedrock (a3-2): the IAM user that may only call bedrock:InvokeModel
# (replaced by an instance role in b4-5). Secret llm/bedrock.
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=

# --- gmail (a4-4): the dedicated SizJobs mailbox, never a personal one.
# The app password needs 2-step verification on that account.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- telegram (a4-5): the bot from @BotFather and the chat it posts to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- langfuse (a6-2): Langfuse Cloud project keys for LLM tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- grafana (a6-1): Grafana Alloy pushing to Grafana Cloud. The URLs and
# numeric user IDs are on the stack's "Details" page; the token is a Cloud
# Access Policy token with metrics:write and logs:write only.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
